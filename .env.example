# API
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
# Where the browser-facing web app lives, used for the password challenge page
WEB_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_URL=postgresql://url_shortener:url_shortener@localhost:5433/url_shortener

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# Rate limiting (requests per window, per key)
RATE_LIMIT_WINDOW_SECONDS=60
AUTHENTICATED_CREATE_RATE_LIMIT=20
ANONYMOUS_CREATE_RATE_LIMIT=10
ANONYMOUS_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
BULK_CREATE_RATE_LIMIT=5
LOGIN_FAILURE_RATE_LIMIT=5
LINK_PASSWORD_RATE_LIMIT=10

# Links
# Anonymous and bulk links always expire after this many days
ANONYMOUS_LINK_TTL_DAYS=2
# Maximum URLs accepted by POST /v1/links/bulk
BULK_MAX_URLS=20

# Kafka (comma-separated brokers)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=url-shortener
KAFKA_GROUP_ID=analytics-consumers
# Only needed for managed Kafka (e.g. Aiven): set both to connect over TLS with
# SASL/PLAIN. Leave both unset for the unauthenticated local Docker Compose
# broker. Never commit real values here.
KAFKA_USERNAME=
KAFKA_PASSWORD=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/url_shortener_analytics
# Salt for hashing visitor IPs before they are stored in analytics
IP_HASH_SALT=replace-with-a-long-random-salt

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Signs the short-lived token that lets a visitor past a link password challenge
LINK_UNLOCK_SECRET=replace-with-a-third-long-random-secret-at-least-32-characters
LINK_UNLOCK_TTL_SECONDS=300

# Short code generation
# Base62 alphabet: position N is the character that digit N encodes to. A shuffled
# order keeps sequential database IDs from producing guessable sequential codes.
# Must be 62 unique alphanumerics. Generate a fresh one per environment with:
#   node -e 'const c=require("node:crypto");const a="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".split("");for(let i=a.length-1;i>0;i--){const j=c.randomInt(i+1);[a[i],a[j]]=[a[j],a[i]]}console.log(a.join(""))'
# Do NOT rotate this after links exist: new codes would be drawn from a different
# order than the ones already handed out.
BASE62_ALPHABET=aYSDtJOZU02NA91PsT4p7CLrkmXfQHqig8cex5F3bjdE6KMRBVynzlhuoGWvwI

# Ticket-server sharding
# The short-code space (62^6 = 56,800,235,584 ids) is split into SHARD_COUNT
# equal contiguous blocks. Each API instance owns exactly one block, so two
# instances can allocate ids concurrently without coordinating.
# SHARD_ID must be unique per running instance. Run extra instances with e.g.
#   SHARD_ID=2 PORT=4002 npm run dev --workspace=@url-shortener/api
# Changing SHARD_COUNT requires re-running db:migrate to create the sequences.
SHARD_COUNT=5
SHARD_ID=1
